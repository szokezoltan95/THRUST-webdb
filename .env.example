POSTGRES_DB=thrust
POSTGRES_USER=thrust
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://thrust:change-me@db:5432/thrust
COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1
SESSION_LIFETIME_HOURS=12
PUBLIC_MIN_GROUP_SIZE=10
MEASUREMENT_STORAGE_PATH=/var/lib/thrust-webdb/measurements
MAX_RAW_UPLOAD_BYTES=50000000

# Comma-separated e-mail addresses or usernames that receive bootstrap superadmin rights
SUPERADMIN_IDENTIFIERS=

# Shared invitation secret; researcher self-registration is disabled when empty.
# Generate a strong value with: openssl rand -hex 32
RESEARCHER_REGISTRATION_KEY=
DATA_CONTROLLER_NAME=
DATA_CONTROLLER_ADDRESS=
DATA_CONTROLLER_EMAIL=
DATA_RETENTION_NOTICE=
